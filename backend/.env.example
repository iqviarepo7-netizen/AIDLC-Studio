GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_LOW=llama-3.1-8b-instant
GROQ_MODEL_MEDIUM=llama-3.3-70b-versatile
GROQ_MODEL_HIGH=llama-3.3-70b-versatile
# Used when the selected Groq model emits a tool call on a plain text request
# (e.g. openai/gpt-oss-*). Must be a chat-only model.
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_LOW=gemini-2.5-flash
GEMINI_MODEL_MEDIUM=gemini-2.5-flash
GEMINI_MODEL_HIGH=gemini-2.5-pro
# Optional defaults when skipping the Connect wizard (session fallback).
# For the Connect screen MCP mode, paste the same URL in the UI.
# Bundled Jira MCP: see mcp-servers/jira (default http://localhost:9001)
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
GIT_MCP_URL=
GIT_MCP_TOKEN=
JIRA_DONE_TRANSITION_ID=
WORKFLOW_STORE_PATH=backend/data/workflows.json
REPOSITORY_PATH=
GITHUB_BASE_BRANCH=main
CORS_ORIGINS=http://localhost:5173
