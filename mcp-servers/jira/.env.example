# Jira Cloud or Server/Data Center
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Optional: force API version / auth (otherwise auto-detected)
# JIRA_API_VERSION=3
# JIRA_AUTH_SCHEME=basic

# Optional: require Studio "MCP token" field to match this Bearer value
# MCP_AUTH_TOKEN=change-me
